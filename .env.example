# Aeon Pass API key. Required by the stdio entrypoint; used by `npm run serve`
# as a fallback when a request carries no X-API-KEY header. Leave it UNSET in
# any hosted deployment — callers supply their own key there.
AEONPASS_API_KEY=your-api-key-here

# Gateway origin. Optional — defaults to production when unset. Set it to point
# at a staging or local gateway. Only the origin is used; any path is ignored.
AEONPASS_BASE_URL=https://apv2-gatewayapp-prod-westus3.azurewebsites.net
